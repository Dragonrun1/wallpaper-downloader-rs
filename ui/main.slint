import { TabWidget } from "std-widgets.slint";
import { ChangerPage, ScreenInfo } from "changer.slint";
export {ScreenInfo } from "changer.slint";

component ProvidersPage inherits Rectangle { Text { text: "Providers"; } }
component SettingsPage inherits Rectangle { Text { text: "Settings"; } }
component DownloadsPage inherits Rectangle { Text { text: "Downloads"; } }
component WallpapersPage inherits Rectangle { Text { text: "Wallpapers"; } }
component AboutPage inherits Rectangle { Text { text: "About"; } }
component HelpPage inherits Rectangle { Text { text: "Help"; } }

export component MainWindow inherits Window {
    title: "Wallpaper Manager";
    min-height: 480px;
    min-width: 640px;
    preferred-width: 800px;
    preferred-height: 600px;

    in-out property <int> current-tab: 0;

    callback tab-changed();

    changed current-tab => { root.tab-changed(); }

    // Changer settings (mirrored from/to the Changer tab)
    in property <[ScreenInfo]> changer-screens;
    in property <bool> changer-per-screen-supported: true;
    in property <int> changer-screens-height: 1;
    in property <int> changer-screens-width: 1;
    in property <string> changer-current;
    in property <string> changer-status;
    in-out property <[string]> changer-directories;
    in-out property <bool> changer-all-monitors: true;
    in-out property <bool> changer-enabled: false;
    in-out property <bool> changer-restore-on-start: true;
    in-out property <int> changer-interval-unit: 1;
    in-out property <int> changer-interval: 30;
    in-out property <int> changer-monitor-mode: 1;
    in-out property <int> changer-order: 0;

    callback changer-add-directory();
    callback changer-browse-directory(int);
    callback changer-change-now();
    callback changer-refresh-screens();
    callback changer-remove-directory(int);
    callback changer-settings-changed();

    TabWidget {
        current-index <=> root.current-tab;

        Tab { title: @tr("Providers"); ProvidersPage { } }
        Tab { title: @tr("Settings"); SettingsPage { } }
        Tab {
            title: @tr("Changer");
            ChangerPage {
                per-screen-supported: root.changer-per-screen-supported;
                screens-height: root.changer-screens-height;
                screens-width: root.changer-screens-width;
                screens: root.changer-screens;
                status: root.changer-status;

                add-directory => { root.changer-add-directory(); }
                browse-directory(i) => { root.changer-browse-directory(i); }
                change-now => { root.changer-change-now(); }
                refresh-screens => { root.changer-refresh-screens(); }
                remove-directory(i) => { root.changer-remove-directory(i); }
                settings-changed => { root.changer-settings-changed(); }

                auto-change <=> root.changer-enabled;
                directories <=> root.changer-directories;
                interval <=> root.changer-interval;
                interval-unit <=> root.changer-interval-unit;
                monitor-mode <=> root.changer-monitor-mode;
                order-index <=> root.changer-order;
                restore-on-start <=> root.changer-restore-on-start;

            }
        }
        Tab { title: @tr("Downloads"); DownloadsPage { } }
        Tab { title: @tr("Wallpapers"); WallpapersPage { } }
        Tab { title: @tr("About"); AboutPage { } }
        Tab { title: @tr("Help"); HelpPage { } }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <int> icon-size: 64;
    icon: root.icon-size <= 16 ? @image-url("./images/wallpaper_icon_16.png")
        : root.icon-size <= 24 ? @image-url("./images/wallpaper_icon_24.png")
        : root.icon-size <= 32 ? @image-url("./images/wallpaper_icon_32.png")
        : root.icon-size <= 64 ? @image-url("./images/wallpaper_icon_64.png")
        : @image-url("./images/wallpaper_icon_128.png");
    tooltip: "Wallpaper Manager";

    callback tray-clicked();
    callback open-tab(int);
    callback change-now();
    callback quit();

    clicked => { root.tray-clicked(); }

    Menu {
        MenuItem { title: @tr("Open"); activated => { root.open-tab(-1); } }
        MenuItem { title: @tr("Settings…"); activated => { root.open-tab(1); } }
        MenuItem { title: @tr("Change Wallpaper Now"); activated => { root.change-now(); } }
        MenuSeparator { }
        MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
    }
}
